{
  "name": "@labs/aidataapps-logwarden",
  "version": "0.1.0",
  "private": true,
  "description": "SQL-native incident capture and reproducible local-LLM agent benchmark",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm test",
    "test": "vitest run",
    "test:sql": "node --import tsx scripts/sql-integration.ts",
    "run:init": "node --import tsx scripts/run-init.ts",
    "mac:model": "node --import tsx scripts/mac-model.ts",
    "mac:eval": "node --import tsx scripts/mac-eval.ts",
    "mac:report": "node --import tsx scripts/mac-eval-report.ts",
    "models:sync": "node --import tsx scripts/sync-model-registry.ts",
    "doctor": "node --import tsx scripts/doctor.ts",
    "db:setup": "node --import tsx scripts/setup-database.ts",
    "capture:drain": "node --import tsx scripts/ingest-sources.ts",
    "scenarios:build": "node --import tsx scripts/scenarios-build.ts",
    "scenarios:inject": "node --import tsx scripts/scenarios-inject.ts",
    "capture:verify": "node --import tsx scripts/capture-verify.ts",
    "db:backup": "node --import tsx scripts/database-checkpoint.ts",
    "db:restore-test": "node --import tsx scripts/database-checkpoint.ts --restore-test",
    "packets:build": "node --import tsx scripts/packets-build.ts",
    "packets:audit": "node --import tsx scripts/packets-audit.ts",
    "telemetry:ingest": "node --import tsx scripts/ingest-telemetry-journal.ts",
    "telemetry:sample": "node --import tsx scripts/telemetry-sampler.ts",
    "telemetry:watch": "node --import tsx scripts/telemetry-sampler.ts --watch",
    "secrets:rotate": "node --import tsx scripts/rotate-local-secrets.ts",
    "checkpoint:once": "./scripts/checkpoint-watchdog.sh --once",
    "checkpoint:watch": "./scripts/checkpoint-watchdog.sh --interval-seconds 1200",
    "run:archive": "node --import tsx scripts/archive-run.ts",
    "run:mirror": "./scripts/mirror-run.sh",
    "repro": "./repro.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mssql": "^12.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}

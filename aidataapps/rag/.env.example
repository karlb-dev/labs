# Compose project isolation
COMPOSE_PROJECT_NAME=aidataapps-rag
# Leave empty for an ordinary Docker host. The Colab bootstrap writes
# colab-rootless and selects compose.colab.yaml for nested-container support.
CONTAINER_RUNTIME_PROFILE=

# SQL Server 2025 Developer container
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2025-latest
SQLSERVER_PORT=1433
MSSQL_SA_PASSWORD=replace-with-a-generated-strong-password
MSSQL_DATABASE=RagLab

# Local model APIs
MODEL_PROFILE=qwen-smoke
CHAT_BASE_URL=http://127.0.0.1:8000/v1
CHAT_PORT=8000
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_PORT=8001
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
VLLM_IMAGE=vllm/vllm-openai:latest
HF_TOKEN=

# App
HOST=127.0.0.1
PORT=3000
TOP_K=4
LOG_LEVEL=info

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jspace-phase4-bank-b-source-v1",
  "title": "Phase 4 Bank B candidate source-verification row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fact_id",
    "source_package",
    "source_package_version",
    "source_record",
    "source_record_sha256",
    "source_url",
    "fields_used",
    "ambiguity_notes",
    "verification_status",
    "independent_sources"
  ],
  "properties": {
    "fact_id": {"type": "string", "minLength": 1},
    "source_package": {"const": "countryinfo"},
    "source_package_version": {"const": "0.1.2"},
    "source_record": {"type": "string", "pattern": "^countryinfo/data/.+\\.json$"},
    "source_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_url": {"type": "string", "pattern": "^https://"},
    "fields_used": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "ambiguity_notes": {"type": "array", "items": {"type": "string"}},
    "verification_status": {"enum": [
      "candidate-single-source-pending-independent-verification",
      "independently-verified",
      "rejected"
    ]},
    "independent_sources": {"type": "array", "items": {
      "type": "object",
      "required": ["url", "checked_utc", "fields"],
      "properties": {
        "url": {"type": "string"},
        "checked_utc": {"type": "string"},
        "fields": {"type": "array", "items": {"type": "string"}}
      }
    }}
  }
}
